# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://attendai:attendai_dev_password@db:5432/attendai?schema=public"

PORT=4000

# Use a long, random string in real deployments (openssl rand -hex 32)
JWT_ACCESS_SECRET="dev_only_change_me_access"
JWT_REFRESH_SECRET="dev_only_change_me_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

AI_SERVICE_URL="http://ai-service:8000"
AI_SERVICE_TOKEN="dev_only_ai_service_secret_token"

# AES-256-GCM encryption key for biometric embeddings (64 hex characters / 32 bytes)
# Generate with: openssl rand -hex 32
BIOMETRIC_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Biometric decision thresholds
FACE_SIMILARITY_THRESHOLD=0.60
VOICE_SIMILARITY_THRESHOLD=0.65
LIVENESS_THRESHOLD=0.70
